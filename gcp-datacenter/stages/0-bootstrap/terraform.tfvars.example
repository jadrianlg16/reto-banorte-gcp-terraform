# Valores de ejemplo (marcadores, no IDs reales). Copiar a terraform.tfvars y ajustar.

org_id            = "000000000000"
billing_account   = "000000-000000-000000"
prefix            = "bnt"
project_suffix    = ""
primary_region    = "us-central1"
github_repository = "example-org/example-repo"

# IDs numéricos del repositorio y de su dueño (base de la confianza de WIF):
#   gh api repos/<dueño>/<repositorio> --jq '.id, .owner.id'
github_repository_id       = "000000000"
github_repository_owner_id = "000000000"

# Bucket de estado y su llave: multirregión US (sobreviven a la caída de primary_region).
# Opcional: doble región configurable con la región primaria y la de DR.
state_bucket_location = "US"
# state_bucket_dual_regions = ["us-central1", "us-east4"]

# Grupo security_admins (el mismo correo que groups.security_admins de la etapa 1): alertas de
# auditoría del proyecto semilla (CIS 2.5 a 2.12).
security_alert_email = "gcp-security-admins@example.com"

labels = {
  app         = "landing-zone"
  owner       = "plataforma"
  cost_center = "ti-001"
}
