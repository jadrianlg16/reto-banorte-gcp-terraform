# Valores de ejemplo (marcadores, no IDs reales). Copiar a terraform.tfvars y ajustar.

# Valor real: la salida project_id de 0-bootstrap (el proyecto único, ADR 0029; el mismo del hub).
project_id  = "example-landing-zone"
prefix      = "bnt"
environment = "qa"
# Valor real: la salida state_bucket de 0-bootstrap.
state_bucket = "bnt-bootstrap-ops-tfstate"

primary_region = "us-central1"
dr_region      = "us-east4"

# En qa las llaves *_dr se reservan pero no se crean.
enable_dr = false

# Plan de direccionamiento (contrato §5), X = 20.
spoke_supernet = "10.20.0.0/16"
subnet_cidrs = {
  app           = "10.20.0.0/20"
  app_dr        = "10.20.16.0/20"
  proxy         = "10.20.32.0/23"
  proxy_dr      = "10.20.34.0/23"
  run           = "10.20.36.0/24"
  run_dr        = "10.20.37.0/24"
  gke_master    = "10.20.38.0/28"
  gke_master_dr = "10.20.38.16/28"
  pods          = "10.20.64.0/18"
  services      = "10.20.128.0/20"
  services_dr   = "10.20.160.0/20"
  psa           = "10.20.176.0/20"
  pods_dr       = "10.20.192.0/18"
}
onprem_cidrs = ["192.168.0.0/16"]

onprem_dns_domain = "corp.example.com."
dns_domain_base   = "empresa.internal."
# Muestreo de flow logs: 0.5 en dev y qa por costo (desviación de CIS 3.10, ADR 0027); 1 en prod.
flow_log_sampling = 0.5

# VIP de las zonas googleapis.com., gcr.io., pkg.dev. y run.app. (restricted o private).
google_apis_vip = "restricted"

# Llamadas de Filestore a los clientes NFS (bloqueo de archivos). Los puertos de statd y
# nlockmgr deben fijarse igual en las VM y nodos clientes.
enable_filestore_nfs_lock_callbacks = true

labels = {
  app         = "network"
  owner       = "example-team"
  cost_center = "example-cc"
}
