# Valores de ejemplo (marcadores, nunca IDs reales). Copiar a terraform.tfvars y ajustar.

org_id          = "000000000000"
billing_account = "000000-000000-000000"
prefix          = "bnt"
project_suffix  = ""
environment     = "qa"
primary_region  = "us-central1"
dr_region       = "us-east4"
# Valor real: la salida state_bucket de 0-bootstrap (<prefix>-bootstrap-ops-tfstate[-<project_suffix>]).
state_bucket    = "bnt-bootstrap-ops-tfstate"

# Debe ser igual a stage_service_accounts["5-workloads"] de las salidas de 0-bootstrap
# (terraform output -json stage_service_accounts); con otro correo la etapa 5 falla por permisos.
workloads_service_account = "bnt-tf-5-workloads@bnt-bootstrap-seed.iam.gserviceaccount.com"

deletion_policy = "PREVENT"

# Repositorio Docker por aplicación (multirregión, llave artifacts de la etapa 2) y Binary
# Authorization: solo se admiten imágenes de ese repositorio, más estos patrones y, si hay
# atestadores, las imágenes atestadas por todos ellos.
artifact_registry_location              = "us"
binary_authorization_allowlist_patterns = []
binary_authorization_attestors          = []

applications = {
  app = {
    apis    = []
    secrets = []
  }
}

labels = {
  owner       = "example-team"
  cost_center = "example-000"
}
