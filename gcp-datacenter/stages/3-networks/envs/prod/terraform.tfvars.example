# Valores de ejemplo (marcadores, no IDs reales). Copiar a terraform.tfvars y ajustar.

billing_account = "000000-000000-000000"
prefix          = "bnt"
project_suffix  = ""
environment     = "prod"
# Valor real: la salida state_bucket de 0-bootstrap (<prefix>-bootstrap-ops-tfstate[-<project_suffix>]).
state_bucket    = "bnt-bootstrap-ops-tfstate"

primary_region = "us-central1"
dr_region      = "us-east4"

# En prod se crean las subredes, el router y el NAT de la región de DR.
enable_dr = true

# Plan de direccionamiento (contrato §5), X = 30.
spoke_supernet = "10.30.0.0/16"
subnet_cidrs = {
  app           = "10.30.0.0/20"
  app_dr        = "10.30.16.0/20"
  proxy         = "10.30.32.0/23"
  proxy_dr      = "10.30.34.0/23"
  run           = "10.30.36.0/24"
  run_dr        = "10.30.37.0/24"
  gke_master    = "10.30.38.0/28"
  gke_master_dr = "10.30.38.16/28"
  pods          = "10.30.64.0/18"
  services      = "10.30.128.0/20"
  services_dr   = "10.30.160.0/20"
  psa           = "10.30.176.0/20"
  pods_dr       = "10.30.192.0/18"
}
onprem_cidrs = ["192.168.0.0/16"]

onprem_dns_domain = "corp.example.com."
dns_domain_base   = "empresa.internal."
flow_log_sampling = 0.5

labels = {
  app         = "network"
  owner       = "example-team"
  cost_center = "example-cc"
}
