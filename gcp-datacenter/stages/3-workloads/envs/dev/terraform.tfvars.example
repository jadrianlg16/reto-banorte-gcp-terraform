# Valores de ejemplo de 3-workloads/dev. Copiar a terraform.tfvars y reemplazar los marcadores.
# El bucket de estado llega también por: terraform init -backend-config="bucket=<bucket>"

# Proyecto único (ADR 0029 §1): lo crea una persona; valor real, la salida project_id de
# 0-bootstrap.
project_id   = "example-lz-000000"
prefix       = "bnt"
environment  = "dev"
application  = "app"
# Valor real: la salida state_bucket de 0-bootstrap.
state_bucket = "bnt-bootstrap-ops-tfstate"

primary_region = "us-central1"
dr_region      = "us-east4"

# Sin DR en dev (§5: las llaves *_dr se reservan pero no se crean).
enable_dr = false
dr_active = false

# dev: solo Cloud Run y Cloud SQL (más Storage, observabilidad y respaldo, que son fijos).
enable_gke          = false
enable_mig          = false
enable_cloud_run    = true
enable_filestore    = false
enable_memorystore  = false
enable_internal_lb  = false
enable_backup       = true
deletion_protection = false

# Imagen del repositorio de dev de la aplicación (salida artifact_registry_repositories de
# 1-base). Una etiqueta de versión o un digest (@sha256:...), nunca latest: el repositorio tiene
# etiquetas inmutables, así que latest no se puede mover a una imagen nueva.
cloud_run_image = "us-docker.pkg.dev/example-lz-000000/bnt-dev-app/api:1.0.0"

# Secretos de secret_ids["dev"] de 1-base que leen las cuentas workload y run (vacío: ninguno).
application_secrets = []

sql_tier             = "db-custom-1-3840"
sql_database_version = "POSTGRES_16"
sql_databases        = ["app"]
# Cambiar (por ejemplo a sql2) si se vuelve a crear dev poco después de un destroy: el nombre de
# una instancia borrada no se reutiliza de inmediato.
sql_instance_name = "sql"

domain_names = ["app.dev.example.com"]

notification_emails = ["alertas-dev@example.com"]

# Apagado fuera de horario (ADR 0028): Cloud SQL detenida de 20:00 a 07:00 (hora de Monterrey)
# y todo el fin de semana. Cloud Run ya escala a 0. La cuenta de los trabajos la crea esta raíz
# con el rol del apagado de 1-base.
off_hours_shutdown = {
  enabled        = true
  time_zone      = "America/Monterrey"
  start_schedule = "0 7 * * 1-5"
  stop_schedule  = "0 20 * * 1-5"
}

labels = {
  app         = "app"
  owner       = "plataforma"
  cost_center = "ti-001"
}
