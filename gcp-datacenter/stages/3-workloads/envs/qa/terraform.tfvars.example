# Valores de ejemplo de 3-workloads/qa. Copiar a terraform.tfvars y reemplazar los marcadores.
# El bucket de estado llega también por: terraform init -backend-config="bucket=<bucket>"

# Proyecto único (ADR 0029 §1): lo crea una persona; valor real, la salida project_id de
# 0-bootstrap.
project_id   = "example-lz-000000"
prefix       = "bnt"
environment  = "qa"
application  = "app"
# Valor real: la salida state_bucket de 0-bootstrap.
state_bucket = "bnt-bootstrap-ops-tfstate"

primary_region = "us-central1"
dr_region      = "us-east4"

# Sin DR en qa (§5: las llaves *_dr se reservan pero no se crean).
enable_dr = false
dr_active = false

enable_gke          = false
enable_mig          = true
enable_cloud_run    = true
enable_filestore    = false
enable_memorystore  = true
enable_internal_lb  = false
enable_backup       = true
deletion_protection = false

mig_image        = "projects/example-images/global/images/family/app-hardened"
mig_machine_type = "e2-standard-2"
mig_min_replicas = 1
mig_max_replicas = 3

# Imagen del repositorio de qa de la aplicación (salida artifact_registry_repositories de
# 1-base): la política de Binary Authorization del proyecto niega las imágenes de otros
# registros. Una etiqueta de versión o un digest, nunca latest.
cloud_run_image = "us-docker.pkg.dev/example-lz-000000/bnt-qa-app/api:1.0.0"

sql_tier             = "db-custom-2-7680"
sql_database_version = "POSTGRES_16"
sql_databases        = ["app"]
# Cambiar (por ejemplo a sql2) si se vuelve a crear qa poco después de un destroy: el nombre de
# una instancia borrada no se reutiliza de inmediato.
sql_instance_name = "sql"

memorystore_memory_gb = 5

domain_names = ["app.qa.example.com"]
lb_backend_paths = {
  mig = ["/legacy/*"]
}

notification_emails = ["alertas-qa@example.com"]

# Apagado fuera de horario (ADR 0028): Cloud SQL detenida y el MIG en 0 VM de 20:00 a 07:00
# (hora de Monterrey) y todo el fin de semana; durante el horario el MIG tiene mig_min_replicas
# VM sin autoescalado por CPU. Memorystore no se puede detener. La cuenta de los trabajos la
# crea esta raíz con el rol del apagado de 1-base.
off_hours_shutdown = {
  enabled        = true
  time_zone      = "America/Monterrey"
  start_schedule = "0 7 * * 1-5"
  stop_schedule  = "0 20 * * 1-5"
}

labels = {
  app         = "app"
  owner       = "plataforma"
  cost_center = "ti-001"
}
